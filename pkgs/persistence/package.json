{
  "name": "@katakit/persistence",
  "version": "0.0.0",
  "description": "Adapter-based event persistence for Katakit.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katabase-ai/katakit.git",
    "directory": "pkgs/persistence"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc --project tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@katakit/core": "workspace:*",
    "@katakit/event-log": "workspace:*",
    "p-limit": "^7.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "valibot": "1.2.0"
  }
}
