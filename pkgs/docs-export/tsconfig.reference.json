{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "customConditions": ["source"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "../core/src",
    "../event-log/src",
    "../persistence/src",
    "../transcription/src",
    "../react/src",
    "../transcript-ingestion/src"
  ],
  "exclude": ["../**/*.test.ts", "../**/*.test.tsx"]
}
