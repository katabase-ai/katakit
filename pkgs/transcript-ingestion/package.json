{
  "name": "@katakit/transcript-ingestion",
  "version": "0.0.0",
  "description": "Source-neutral transcript ingestion and conversation turn assembly.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc --project tsconfig.json",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@katakit/core": "workspace:*"
  },
  "peerDependencies": {
    "@katakit/core": "workspace:^"
  }
}
