{
  "name": "@katakit/react",
  "version": "0.1.0",
  "description": "Katakit developer tools for React applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katabase-ai/katakit.git",
    "directory": "pkgs/react"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev-tools": {
      "source": "./src/dev-tools.ts",
      "types": "./dist/dev-tools.d.ts",
      "default": "./dist/dev-tools.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./dev-tools": {
        "types": "./dist/dev-tools.d.ts",
        "default": "./dist/dev-tools.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc --project tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@katakit/core": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "happy-dom": "^18.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "@katakit/core": "workspace:^",
    "react": "^19.0.0"
  }
}
