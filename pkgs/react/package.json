{
  "name": "@katakit/react",
  "version": "0.1.0",
  "description": "Katakit developer tools for React applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katabase-ai/katakit.git",
    "directory": "pkgs/react"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
