{
  "name": "@katakit/react",
  "version": "0.0.0",
  "description": "React bindings for Katakit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katabase-ai/katakit.git",
    "directory": "pkgs/react"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev-tools": {
      "source": "./src/dev-tools/index.tsx",
      "types": "./dist/dev-tools.d.ts",
      "default": "./dist/dev-tools.js"
    },
    "./dev-tools.css": {
      "source": "./src/dev-tools/styles.css",
      "default": "./dist/dev-tools.css"
    },
    "./dev-tools/mount": {
      "source": "./src/dev-tools/mount.ts",
      "types": "./dist/dev-tools/mount.d.ts",
      "default": "./dist/dev-tools/mount.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./dev-tools": {
        "types": "./dist/dev-tools.d.ts",
        "default": "./dist/dev-tools.js"
      },
      "./dev-tools.css": "./dist/dev-tools.css",
      "./dev-tools/mount": {
        "types": "./dist/dev-tools/mount.d.ts",
        "default": "./dist/dev-tools/mount.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node build-styles.mjs",
    "tsc": "tsc --project tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@katakit/core": "workspace:*",
    "@katakit/transcript-ingestion": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "happy-dom": "^18.0.1",
    "lightningcss": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
