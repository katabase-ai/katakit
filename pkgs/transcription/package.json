{
  "name": "@katakit/transcription",
  "version": "0.0.0",
  "description": "Source-neutral conversation transcription plugin for Katakit.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "source": "./src/models/index.ts",
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    },
    "./whisper-worker": {
      "source": "./src/models/whisperWorker.ts",
      "types": "./dist/models/whisperWorker.d.ts",
      "default": "./dist/models/whisperWorker.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./models": {
        "types": "./dist/models/index.d.ts",
        "default": "./dist/models/index.js"
      },
      "./whisper-worker": {
        "types": "./dist/models/whisperWorker.d.ts",
        "default": "./dist/models/whisperWorker.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc --project tsconfig.json",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@katakit/core": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@moonshine-ai/moonshine-wasm": "0.1.5",
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependencies": {
    "@moonshine-ai/moonshine-wasm": "0.1.5",
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependenciesMeta": {
    "@moonshine-ai/moonshine-wasm": {
      "optional": true
    },
    "@xenova/transformers": {
      "optional": true
    }
  }
}
