{
  "name": "@katakit/transcription",
  "version": "0.0.0",
  "description": "Source-neutral conversation transcription plugin for Katakit.",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc --project tsconfig.json",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@katakit/core": "workspace:*",
    "rxjs": "^7.8.2"
  }
}
