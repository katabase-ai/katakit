{
  "name": "@katakit/devtools",
  "version": "0.1.0",
  "description": "Browser timeline for Katakit observable deliveries.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katabase-ai/katakit.git",
    "directory": "pkgs/devtools"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "tsc": "tsc --project tsconfig.json",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@katakit/core": "workspace:*"
  },
  "peerDependencies": {
    "@katakit/core": "workspace:^"
  }
}
