{
  "name": "@katakit/core",
  "version": "0.0.0",
  "description": "Framework-independent Katakit primitives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katabase-ai/katakit.git",
    "directory": "pkgs/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./katakit": {
      "source": "./src/katakit.ts",
      "types": "./dist/katakit.d.ts",
      "default": "./dist/katakit.js"
    },
    "./effect": {
      "source": "./src/effect.ts",
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    },
    "./utils/reactive/eager": {
      "source": "./src/utils/reactive/eager.ts",
      "types": "./dist/utils/reactive/eager.d.ts",
      "default": "./dist/utils/reactive/eager.js"
    },
    "./utils/reactive/skipReplay": {
      "source": "./src/utils/reactive/skipReplay.ts",
      "types": "./dist/utils/reactive/skipReplay.d.ts",
      "default": "./dist/utils/reactive/skipReplay.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "rxjs": "^7.8.2",
    "rxjs-for-await": "^1.0.0"
  }
}
