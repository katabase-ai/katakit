{
  "compilerOptions": {
    "target": "es2022",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "customConditions": ["source"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "../../../pkgs/core/src",
    "../../../pkgs/event-log/src",
    "../../../pkgs/persistence/src",
    "../../../pkgs/transcription/src",
    "../../../pkgs/react/src",
    "../../../pkgs/transcript-ingestion/src"
  ],
  "exclude": ["../../../pkgs/**/*.test.ts", "../../../pkgs/**/*.test.tsx"]
}
