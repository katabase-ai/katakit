{
  "name": "katakit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:pkgs && pnpm --filter \"!./pkgs/*\" -r build",
    "build:pkgs": "pnpm --filter \"./pkgs/*\" -r build",
    "publint": "pnpm --filter \"./pkgs/*\" -r exec publint --pack pnpm --strict",
    "tsc": "pnpm -F @katakit/react build && pnpm -r tsc",
    "lint": "oxlint --deny-warnings && pnpm structure:check",
    "licenses:check": "node scripts/check-licenses.mjs",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky install",
    "test": "vitest",
    "test:ci": "pnpm -F @katakit/react build && vitest run --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm licenses:check && pnpm templates:check && pnpm examples:check && pnpm release:check && pnpm tsc && pnpm test:ci && pnpm -F @katakit/docs check && pnpm -F @katakit/docs-export test:ci && pnpm build && pnpm publint",
    "release:plan": "node scripts/release.mjs plan",
    "release:pack": "node scripts/release.mjs pack",
    "release:publish": "node scripts/release.mjs publish",
    "release:check": "node --test scripts/release.test.mjs",
    "docs:export": "pnpm --filter @katakit/docs-export export",
    "templates:check": "node scripts/check-template-manifests.mjs && node --test scripts/check-template-manifests.test.mjs",
    "templates:copy-check": "node scripts/check-template-copy.mjs",
    "examples:copy": "node scripts/copy-example.mjs",
    "examples:check": "node --test scripts/copy-example.test.mjs",
    "examples:copy-check": "pnpm demos:copy-check && pnpm gallery:copy-check && pnpm templates:copy-check",
    "demos:copy-check": "node scripts/check-demo-copy.mjs",
    "gallery:copy-check": "node scripts/check-demo-copy.mjs gallery",
    "demos:ui-sync": "node scripts/sync-standalone-ui.mjs",
    "demos:ui-check": "node scripts/sync-standalone-ui.mjs --check",
    "structure:check": "node scripts/check-structure.mjs && node --test scripts/check-structure.test.mjs scripts/sync-standalone-ui.test.mjs && pnpm demos:ui-check"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "husky": "8.0.3",
    "lint-staged": "15.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "publint": "^0.3.25",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4",
    "wrangler": "4.162.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --deny-warnings --fix --no-error-on-unmatched-pattern",
      "oxfmt"
    ],
    "**/*.json": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "**/*.md": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0"
}
