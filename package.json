{
  "name": "katakit",
  "private": true,
  "type": "module",
  "scripts": {
    "gallery:dev": "pnpm --filter @katakit/gallery dev",
    "gallery:build": "pnpm --filter @katakit/gallery build",
    "demo:transcription": "pnpm --filter @katakit/demo-transcription dev",
    "docs:dev": "pnpm --filter @katakit/docs dev",
    "docs:build": "pnpm --filter @katakit/docs build",
    "docs:check": "pnpm --filter @katakit/docs check",
    "build": "pnpm -r build",
    "tsc": "pnpm -r tsc",
    "lint": "oxlint --deny-warnings && node scripts/check-licenses.mjs",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky install",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm tsc && pnpm test:ci && pnpm docs:check && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "husky": "8.0.3",
    "lint-staged": "15.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --deny-warnings --fix --no-error-on-unmatched-pattern",
      "oxfmt"
    ],
    "**/*.json": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "**/*.md": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0"
}
