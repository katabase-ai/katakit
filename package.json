{
  "name": "katakit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "tsc": "tsc --incremental",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm tsc && pnpm test:ci && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
