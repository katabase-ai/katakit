{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "sortPackageJson": true,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "*.lock",
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    "**/__generated__/",
    "examples/demos/gallery/src/routeTree.gen.ts"
  ]
}
