{
  "include": ["pkgs/*/src", "pkgs/*/*.config.ts", "*.config.ts"],
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "paths": {
      "@katakit/core": ["./pkgs/core/src/index.ts"],
      "@katakit/core/*": ["./pkgs/core/src/*"],
      "@katakit/event-log": ["./pkgs/event-log/src/plugin.ts"],
      "@katakit/react": ["./pkgs/react/src/index.ts"]
    }
  }
}
